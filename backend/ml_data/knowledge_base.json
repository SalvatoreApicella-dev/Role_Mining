{
    "redundancy_rules": {
        "G-Admin-All": [
            "G-Admin-Read",
            "G-Admin-Write"
        ],
        "Azure_All": [
            "Azure_1",
            "Azure_Read",
            "Azure_Write"
        ],
        "AWS_FullAccess": [
            "AWS_ReadOnlyAccess",
            "AWS_PowerUserAccess"
        ],
        "GitLab_Owner": [
            "GitLab_Developer",
            "GitLab_Maintainer",
            "GitLab_Reporter",
            "GitLab_Guest"
        ]
    },
    "hierarchy_patterns": [
        {
            "root": "_Admin",
            "supersedes": [
                "_Read",
                "_Write",
                "_View",
                "_List",
                "_User"
            ]
        },
        {
            "root": "_Full",
            "supersedes": [
                "_Read",
                "_Write",
                "_View",
                "_List",
                "_User"
            ]
        },
        {
            "root": "_Write",
            "supersedes": [
                "_Read",
                "_View",
                "_List"
            ]
        },
        {
            "root": "_All",
            "supersedes": [
                "_1",
                "_2",
                "_3",
                "_Read",
                "_View"
            ]
        }
    ]
}